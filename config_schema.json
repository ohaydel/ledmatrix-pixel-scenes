{
  "type": "object",
  "properties": {
    "enabled": {
      "type": "boolean",
      "default": true,
      "description": "Enable Pixel Scenes"
    },
    "display_duration": {
      "type": "number",
      "default": 20,
      "minimum": 5,
      "maximum": 300,
      "description": "Seconds Pixel Scenes remains on screen"
    },
    "animation_speed": {
      "type": "number",
      "default": 1.0,
      "minimum": 0.25,
      "maximum": 4.0,
      "description": "Overall animation speed"
    },
    "scene_mode": {
      "type": "string",
      "enum": [
        "random",
        "synthwave",
        "lightning",
        "arcade",
        "mardi_gras"
      ],
      "default": "random",
      "description": "Choose a specific scene or randomly select one each rotation"
    },
    "enable_synthwave": {
      "type": "boolean",
      "default": true,
      "description": "Enable Synthwave Horizon"
    },
    "enable_lightning": {
      "type": "boolean",
      "default": true,
      "description": "Enable Lightning Storm"
    },
    "enable_arcade": {
      "type": "boolean",
      "default": true,
      "description": "Enable Retro Arcade"
    },
    "enable_mardi_gras": {
      "type": "boolean",
      "default": true,
      "description": "Enable Mardi Gras"
    }
  },
  "required": ["enabled"],
  "additionalProperties": false
